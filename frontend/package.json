    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
